# Voxa Configuration
# Copy this to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Models
WHISPER_MODEL=whisper-1
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# Audio settings
SAMPLE_RATE=16000
SILENCE_THRESHOLD_MS=700
VAD_AGGRESSIVENESS=2

# Activation
WAKE_WORD=hey voxa
HOTKEY_COMBO=cmd+shift+v

# Browser
DEFAULT_BROWSER=Google Chrome

# Safety
CONFIRM_DANGEROUS_COMMANDS=true
DANGEROUS_COMMANDS=rm,kill,sudo,chmod,chown,mkfs,dd,shutdown,reboot

# Logging
LOG_LEVEL=INFO
LOG_FILE=voxa.log

# --- New Feature Settings ---

# Ollama (local LLM fallback when OpenAI is unavailable)
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Conversation Mode (stay listening N seconds after a command for follow-ups)
CONVERSATION_MODE=false
FOLLOWUP_WINDOW_SECONDS=8

# Web Dashboard (http://localhost:7429)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=7429

# Memory (always-on ambient listening)
# Keep the audio clip of each meaningful chunk on disk for playback.
MEMORY_KEEP_AUDIO=true
# RMS threshold (0..32767) below which an incoming chunk is treated as silence
# and dropped before it costs a Whisper call.
MEMORY_SILENCE_RMS=180

# Meeting Detection (Granola-style auto-capture)
# When true, Voxa watches for Zoom/Meet/Teams/Webex meetings. By default it
# asks "Record this meeting?" and only captures when you say yes.
MEETING_AUTO_DETECT=false
MEETING_POLL_INTERVAL=10
# Require the mic to be live before treating a browser tab as a real meeting.
MEETING_REQUIRE_MIC=true
# Skip the prompt and record every detected meeting automatically.
MEETING_AUTO_RECORD=false
# Capture audio in the app (reliable mic access) and stream to the backend.
MEETING_EXTERNAL_AUDIO=true
# Also capture system audio (the other participants) for both-sides notes.
# Requires Screen Recording permission. Set false for mic-only.
MEETING_CAPTURE_SYSTEM_AUDIO=true

# --- Integrations (Settings → Accounts in the app) ---
# Google: create an OAuth client (type: Desktop app) at https://console.cloud.google.com/apis/credentials
# Enable the "Google Calendar API" and "Gmail API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://127.0.0.1:7430/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
