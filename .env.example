# Voxa Configuration
# Copy this to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# Models
WHISPER_MODEL=whisper-1
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# Audio settings
SAMPLE_RATE=16000
SILENCE_THRESHOLD_MS=700
VAD_AGGRESSIVENESS=2

# Activation
WAKE_WORD=hey voxa
HOTKEY_COMBO=cmd+shift+v

# Browser
DEFAULT_BROWSER=Google Chrome

# Safety
CONFIRM_DANGEROUS_COMMANDS=true
DANGEROUS_COMMANDS=rm,kill,sudo,chmod,chown,mkfs,dd,shutdown,reboot

# Logging
LOG_LEVEL=INFO
LOG_FILE=voxa.log

# --- New Feature Settings ---

# Ollama (local LLM fallback when OpenAI is unavailable)
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Conversation Mode (stay listening N seconds after a command for follow-ups)
CONVERSATION_MODE=false
FOLLOWUP_WINDOW_SECONDS=8

# Web Dashboard (http://localhost:7429)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=7429
